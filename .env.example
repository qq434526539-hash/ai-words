# ===== Supabase（第三阶段接入；未配置时自动使用本地 localStorage 模式）=====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== OpenAI 兼容 API（第四阶段；未配置时使用本地模拟回答）=====
# 支持任何 OpenAI 兼容协议的服务：OpenAI、DeepSeek、OpenRouter、本地 Ollama 等
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 重要：NEXT_PUBLIC_ 前缀的变量会暴露给浏览器；
# OPENAI_API_KEY 等密钥只能放在服务端（route handler / server components），严禁写入前端代码。
